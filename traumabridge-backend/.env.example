# =============================================================================
# TraumaBridge AI — PRODUCTION ENVIRONMENT VARIABLES
# Copy to .env and fill in real values before deployment.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
SECRET_KEY=INSECURE-CHANGE-IN-PRODUCTION-256-bit-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# --- Database (PostgreSQL async) ---
DATABASE_URL=postgresql+asyncpg://tba_user:password@localhost:5432/traumabridge
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Groq LPU (MIST entity extraction — NOT clinical AI) ---
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=5.0

# --- Blood Bank Webhook ---
BLOOD_BANK_WEBHOOK_URL=https://bloodbank.hospital.internal/api/reserve
BLOOD_BANK_API_KEY=

# --- Telematics / GPS ---
TELEMATICS_API_URL=https://telematics.traumabridge.internal/api/v1
TELEMATICS_API_KEY=

# --- ABDM (Ayushman Bharat Digital Mission) ---
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_MOCK=true

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Anti-Fraud ---
ASYSTOLE_MIN_DURATION_MS=3000
